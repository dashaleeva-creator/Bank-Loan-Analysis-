      <aliases enabled='yes' />
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_1129277617799802880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Loan Applications' datatype='integer' name='[Calculation_1129277617800929282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#13;&#10;DATEDIFF(&apos;month&apos;,[issue_date], {MAX([issue_date])}) = 0&#13;&#10;THEN&#13;&#10;[id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='MOM Loan Applications' datatype='real' name='[Calculation_1129277617803014149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1129277617800929282]-[MTD Loan Applications (copy)_1129277617802727428])/[MTD Loan Applications (copy)_1129277617802727428]' />
      </column>
      <column caption='Total Funded Amount' datatype='integer' name='[Calculation_1129277617804013574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_amount])' />
      </column>
      <column caption='MOM Total Funded' datatype='real' name='[Calculation_1129277617806639113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_1129277617804836871]-[MTD Total Funded Amount (copy)_1129277617806458888])/[MTD Total Funded Amount (copy)_1129277617806458888]' />
      </column>
      <column caption='Total Amount Received' datatype='integer' name='[Calculation_1129277617807220746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_payment])' />
      </column>
      <column caption='MOM Amount Received' datatype='real' name='[Calculation_692428454194425858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Total Funded Amount (copy)_692428454193315840]-[MTD Total Amount Received (copy)_692428454194229249])/[MTD Total Amount Received (copy)_692428454194229249]' />
      </column>
      <column caption='Avg Int Rate' datatype='real' name='[Calculation_692428454196469763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
      <column caption='MOM Avg Int Rate' datatype='real' name='[Calculation_692428454200639495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_692428454198165509]-[MTD Avg Int Rate   (copy)_692428454200393734])/[MTD Avg Int Rate   (copy)_692428454200393734]' />
      </column>
      <column caption='Avg DTI' datatype='real' name='[Calculation_692428454202077192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dti])' />
      </column>
      <column caption='MOM Avg DTI' datatype='real' name='[Calculation_692428454203600907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Avg Int Rate   (copy)_692428454202605577]-[MTD Avg DTI (copy)_692428454203301898])/[MTD Avg DTI (copy)_692428454203301898]' />
      </column>
      <column caption='Good Loan %' datatype='real' name='[Calculation_692428454215180304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good Loan vs Bad Loan]=&apos;Good Loan&apos; THEN [id] END)/COUNT([id])' />
      </column>
      <column caption='Good Loan Applicatiions' datatype='integer' name='[Calculation_692428454218338321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good Loan vs Bad Loan]=&apos;Good Loan&apos; THEN[id]END)' />
      </column>
      <column caption='dynamic measure' datatype='integer' name='[Calculation_692428454255710234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] =   &apos;Total Loan Applications &apos; THEN[Calculation_1129277617799802880]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;[Total Funded Amount]&apos; THEN[Calculation_1129277617804013574]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Total Amount Received&apos; THEN[Calculation_1129277617807220746]&#13;&#10;END' />
      </column>
      <column caption='Bad Loan  Amount Received  ' datatype='integer' name='[Good Loan  Amount Received  (copy)_692428454230016025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Good Loan vs Bad Loan]=&apos;Bad Loan&apos; THEN[total_payment]END)' />
      </column>
      <column caption='Bad Loan % (copy)' datatype='real' name='[Good Loan % (copy)_692428454226878485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good Loan vs Bad Loan]=&apos;Bad Loan&apos; THEN [id] END)/COUNT([id])' />
      </column>
      <column caption='Good Loan Applicatiions (copy) (copy)' datatype='integer' name='[Good Loan Applicatiions (copy) (copy)_692428454228684823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good Loan vs Bad Loan]=&apos;Good Loan&apos; THEN[id]END)' />
      </column>
      <column caption='Good Loan Funded Amount' datatype='integer' name='[Good Loan Applicatiions (copy)_692428454219714578]' role='measure' type='quantitative'>
